# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Accept Button Detection
# Search area around screen center (the "Your game is ready" popup is larger now)
ACCEPT_REGION_WIDTH=1000
ACCEPT_REGION_HEIGHT=600
# Fallback: detect the green Accept button by color when no template matches
ACCEPT_COLOR_FALLBACK=1

# Image Recognition Settings
CONFIDENCE_ACCEPT=0.80
CONFIDENCE_SEARCHING=0.70
CONFIDENCE_SEARCH_BTN=0.70
CONFIDENCE_STOP_BTN=0.75

# Timing Settings (in seconds)
SCAN_INTERVAL=0.30
CLICK_COOLDOWN=1.00
MESSAGE_COOLDOWN=5.00
